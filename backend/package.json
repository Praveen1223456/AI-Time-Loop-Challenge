{
  "name": "time-loop-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Express + MongoDB API for the AI Time-Loop Challenge",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seedSample.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/unit/repositories.contract.test.js",
    "verify:gemini": "node src/scripts/verifyGemini.js"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
