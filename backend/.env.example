# Copy to backend/.env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development

# Required (except NODE_ENV=test). Local: mongodb://127.0.0.1:27017/timeloop   Atlas: mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/timeloop

# Gemini scenario generation (optional: without BOTH of these, sample scenarios still play and
# POST /scenarios answers 503 AI_NOT_CONFIGURED). Server-side only: never expose these to the browser.
GEMINI_API_KEY=
# Use a currently supported model id from Google's Gemini API docs suitable for generateContent and structured JSON
# (e.g. gemini-3.5-flash-lite, gemini-3.1-flash-lite, or gemini-3-flash-preview). Deliberately not hard-coded.
GEMINI_MODEL=gemini-3.5-flash-lite
# Per-attempt hard timeout (1000-120000 ms) and how many times to retry a failed/invalid attempt (0-4).
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_RETRIES=2

# The single allowed browser origin for CORS (exact scheme + host + port of the frontend).
CLIENT_URL=http://localhost:5173
